{
  "name": "bigpipe-util",
  "description": "The JavaScript runtime of BigPipe for PHP: shows the pagelets of a page as they stream in, applies the DOM operations of the server, loads the next page into the layout and calls the JavaScript modules the server asks for.",
  "version": "2.1.1",
  "keywords": [
    "bigpipe",
    "pagelets",
    "streaming",
    "page-transitions",
    "server-driven",
    "php",
    "xhr",
    "html",
    "dom",
    "async",
    "javascript"
  ],
  "homepage": "https://github.com/richardDobron/bigpipe-util",
  "author": "Richard Dobroň",
  "repository": {
    "type": "git",
    "url": "git://github.com/richardDobron/bigpipe-util.git"
  },
  "bugs": {
    "url": "https://github.com/richardDobron/bigpipe-util/issues"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./dist/*.js": {
      "import": "./dist/esm/*.js",
      "require": "./dist/*.js"
    },
    "./dist/*": {
      "import": "./dist/esm/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:cjs": "babel src --out-dir dist --ignore \"src/**/__tests__/**\"",
    "build:esm": "babel src --out-dir dist/esm --env-name esm --ignore \"src/**/__tests__/**\"",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.0",
    "rimraf": "^6.1.3",
    "vitest": "^5.0.2"
  }
}
